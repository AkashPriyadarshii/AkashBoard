.gradle/6.5/
.gradle/7.0/
.gradle/7.5/
.gradle/8.0/

# Environment
.env
.env.local
.env.*.local

# Node (if used for tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if used for prototyping)
python/__pycache__/
python/*.pyc
python/venv/
python/.venv/

# Documentation build
docs/_build/

# Temporary files
*.tmp
*.temp
*.bak
*.orig
