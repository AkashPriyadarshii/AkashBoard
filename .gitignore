.gradle/
build/
app/build/
engine/target/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
*.iws
*.ipr

# Keystore files (DO NOT commit)
*.jks
*.keystore

# Google Services (if used)
google-services.json

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# NDK
obj/

# Rust
engine/target/
**/*.rs.bk

# Cargo
Cargo.lock

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# VS Code
.vscode/
*.code-workspace

# Android Studio
*.hprof
.cxx/
*.so.bak

# Fastlane (for F-Droid/Play Store)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Release artifacts
app/release/
app/debug/
*.jks
*.keystore

# NDK build artifacts
app/src/main/obj/
app/src/main/libs/

